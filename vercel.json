{
  "version": 2,
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth-router?_route=:path*"
    },
    {
      "source": "/api/replays/:path*",
      "destination": "/api/replays-router?_route=:path*"
    },
    {
      "source": "/api/profile/:path*",
      "destination": "/api/profile-router?_route=:path*"
    },
    {
      "source": "/api/catalog/:path*",
      "destination": "/api/catalog-router?_route=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
