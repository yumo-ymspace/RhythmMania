# Environment runtime flags (production vs development/preview)
# NODE_ENV: 'development' | 'production' | 'test'
# VERCEL_ENV: 'development' | 'preview' | 'production' (automatically set by Vercel deployments)
NODE_ENV=development
VERCEL_ENV=development

# Database connection parameters (PostgreSQL)
DATABASE_URL=postgresql://
PGHOST=IP_ADDRESS
PGPORT=5432
PGDATABASE=DATABASE_NAME
PGUSER=DATABASE_USER
PGPASSWORD=DATABASE_PASSWORD
PGSSLMODE=SSL_MODE
# Only set true for an explicitly approved non-TLS beta database.
ALLOW_INSECURE_PG_TLS=false

# Session / Auth security secret
SESSION_SECRET=SECRET_STRING

# Discrete long-note ticks. Set both values to the same integer from 10 to 100.
# The VITE_ value is embedded in the client build; the server value verifies uploads.
VITE_HOLD_TICK_INTERVAL_MS=50
HOLD_TICK_INTERVAL_MS=50

# Google OAuth Credentials
GOOGLE_CLIENT_ID=.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-

# osu! API v2 OAuth app (Authorization Code exchange/refresh only — not used for user search)
# Callback must match this deploy origin, e.g. https://rhythm-mania.com/api/auth/osu/callback
OSU_CLIENT_ID=OSU_CLIENT_ID
OSU_CLIENT_SECRET=OSU_CLIENT_SECRET
